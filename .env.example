# ============================================================================
# Sniro — LLM configuration
# ----------------------------------------------------------------------------
# Copy this file to `.env.local` and uncomment ONE preset below (or write your
# own). Restart `npm run dev` after changes.
# ============================================================================

# ---- OpenAI ----------------------------------------------------------------
# VITE_LLM_BASE_URL=https://api.openai.com/v1
# VITE_LLM_API_KEY=sk-...
# VITE_LLM_MODEL=gpt-4o-mini

# ---- Groq (OpenAI-compatible) ---------------------------------------------
# VITE_LLM_BASE_URL=https://api.groq.com/openai/v1
# VITE_LLM_API_KEY=gsk_...
# VITE_LLM_MODEL=llama-3.3-70b-versatile

# ---- Ollama (local, no key required) --------------------------------------
# VITE_LLM_BASE_URL=http://localhost:11434/v1
# VITE_LLM_API_KEY=ollama
# VITE_LLM_MODEL=llama3.2

# ---- LM Studio (local) ----------------------------------------------------
# VITE_LLM_BASE_URL=http://localhost:1234/v1
# VITE_LLM_API_KEY=lm-studio
# VITE_LLM_MODEL=local-model

# ---- Anthropic (OpenAI-compatible endpoint) -------------------------------
# VITE_LLM_BASE_URL=https://api.anthropic.com/v1
# VITE_LLM_API_KEY=sk-ant-...
# VITE_LLM_MODEL=claude-sonnet-4-6

# ---- OpenRouter (gateway to many providers) -------------------------------
# VITE_LLM_BASE_URL=https://openrouter.ai/api/v1
# VITE_LLM_API_KEY=sk-or-...
# VITE_LLM_MODEL=openai/gpt-4o-mini

# ---- Pollinations (anonymous, no key) — routed via the Vite proxy ---------
# Pollinations serves a deprecation notice instead of real output when it
# sees a browser Origin/Referer, so this preset routes through Vite's proxy
# (which strips those headers server-side). Works in `npm run dev` and
# `npm run preview`; for production deploys, use a different provider or
# run your own proxy with the same header stripping.
# VITE_LLM_BASE_URL=/api/llm
# VITE_LLM_API_KEY=
# VITE_LLM_MODEL=openai-fast
# LLM_UPSTREAM=https://text.pollinations.ai/openai

# ---- Internal / air-gapped endpoint (via Vite proxy, bypasses CORS) -------
# Use this when your LLM endpoint doesn't send CORS headers. Vite's dev and
# preview servers will forward /api/llm/* to LLM_UPSTREAM.
# VITE_LLM_BASE_URL=/api/llm
# VITE_LLM_API_KEY=your-key-or-leave-blank
# VITE_LLM_MODEL=your-model-name
# LLM_UPSTREAM=http://internal-llm.example.com:8080/v1

# ---- System prompt (optional override) ------------------------------------
# If left unset, the app auto-generates a grounded Hebrew prompt from
# `src/content/team.ts` (team members, commander, projects, tone).
# Edit `src/content/team.ts` to update the facts — the prompt refreshes
# on the next request automatically.
#
# Uncomment the line below only if you want to override the generated prompt:
# VITE_LLM_SYSTEM_PROMPT="your custom prompt here"
