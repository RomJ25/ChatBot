# Vendor the pnpm content-addressable store inside the repo so
# `pnpm install --offline` works on air-gapped machines after a fresh clone.
#
# Tarballs land in ./.pnpm-store/v3/files/<hash> and are committed to Git
# (marked binary via .gitattributes so Git skips diff/delta work). pnpm picks
# the right platform binaries at install time on each user's machine — the
# store can carry multiple platforms via supportedArchitectures.
#
# Refresh workflow (run on a machine with internet):
#   1. rm -rf node_modules .pnpm-store
#   2. pnpm fetch --config.supportedArchitectures.os=win32 \
#                 --config.supportedArchitectures.cpu=x64
#   3. rm -rf node_modules && pnpm install --offline --frozen-lockfile
#      (verifies the store before committing)
#   4. pnpm -F sniro build && pnpm -F de-vincho build
#   5. git add .pnpm-store && git commit -m "refresh vendored pnpm store"
#
# Offline machine workflow:
#   git clone <repo> && cd Sniro
#   pnpm install --offline --frozen-lockfile
#   pnpm dev:sniro

store-dir=./.pnpm-store
package-import-method=copy
prefer-offline=true

# Multi-platform support in the vendored store: include the prep host's
# OS plus all deploy targets. pnpm picks the right native binaries
# (esbuild, rollup) at install time per machine.
supportedArchitectures.os[]=current
supportedArchitectures.os[]=win32
supportedArchitectures.os[]=linux
supportedArchitectures.os[]=darwin
supportedArchitectures.cpu[]=current
supportedArchitectures.cpu[]=x64
supportedArchitectures.cpu[]=arm64
