{
  "name": "sniro-workspace",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "pnpm@10.14.0",
  "engines": {
    "node": ">=20.10.0",
    "pnpm": ">=10"
  },
  "scripts": {
    "dev:sniro": "pnpm -F sniro dev",
    "dev:de-vincho": "pnpm -F de-vincho dev",
    "build:sniro": "pnpm -F sniro build",
    "build:de-vincho": "pnpm -F de-vincho build",
    "preview:sniro": "pnpm -F sniro preview",
    "preview:de-vincho": "pnpm -F de-vincho preview",
    "typecheck": "pnpm -r typecheck",
    "bootstrap": "node scripts/setup.mjs",
    "extract": "node scripts/extract.mjs",
    "bundle:sniro": "bun scripts/bundle.ts sniro",
    "bundle:de-vincho": "bun scripts/bundle.ts de-vincho",
    "bundle:all": "pnpm bundle:sniro && pnpm bundle:de-vincho",
    "prompt:sniro": "bun scripts/prompt-preview.ts sniro",
    "prompt:de-vincho": "bun scripts/prompt-preview.ts de-vincho",
    "doctor": "bun scripts/doctor.ts"
  }
}
